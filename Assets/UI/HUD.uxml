            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="user-input-container" style="flex-grow: 1; top: auto; right: auto; position: absolute; flex-direction: row; flex-wrap: nowrap; left: 0; bottom: 0; padding-top: 12px; padding-right: 12px; padding-bottom: 12px; padding-left: 12px;">
            <ui:VisualElement name="throttle" style="flex-grow: 1; align-items: center; justify-content: center;">
                <ui:Image source="project://database/Assets/Sprites/tsc_icon%20(white).png?fileID=2800000&amp;guid=e42adeb186bb57b45b8fec646c7b74e4&amp;type=3#tsc_icon (white)" tint-color="rgb(88, 203, 255)" name="tsc-indicator" style="width: 20px; height: 20px; background-color: rgb(255, 255, 255); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                <ui:Label text="THROTTLE" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=d47ba0c5d91fd714aafb7dc6e31a9c3d&amp;type=3#Nunito-VariableFont_wght&quot;); -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 9px; width: auto; align-self: center; -unity-text-align: upper-center; margin-bottom: 4px; padding-bottom: 0; margin-right: 0; margin-left: 0; padding-left: 0; padding-right: 0; padding-top: 0; margin-top: 4px;"/>
                <ui:VisualElement style="flex-grow: 1; aspect-ratio: 1; width: 50px; background-color: rgba(255, 255, 255, 0); height: 50px; min-width: 50px; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; align-items: center; justify-content: space-around; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
                    <ui:VisualElement name="semi-transparent" style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgba(88, 203, 255, 0.5); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.8 0.8;"/>
                    <ui:VisualElement name="opaque" style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgb(88, 203, 255); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.5 0.5; position: absolute; bottom: 0; right: 0; top: 0; left: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgb(255, 255, 255); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.1 0.1; position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="brake" style="flex-grow: 1; align-items: center; justify-content: center; margin-left: 8px;">
                <ui:Image source="project://database/Assets/Sprites/abs_icon%20(white).png?fileID=2800000&amp;guid=723d68bca2fb9074a9c33cbb3a1525cd&amp;type=3#abs_icon (white)" tint-color="rgb(255, 88, 90)" name="abs-indicator" style="width: 20px; height: 20px; background-color: rgb(255, 255, 255); border-top-left-radius: 50%; border-top-right-radius: 50%; border-bottom-right-radius: 50%; border-bottom-left-radius: 50%; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                <ui:Label text="BRAKE" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=d47ba0c5d91fd714aafb7dc6e31a9c3d&amp;type=3#Nunito-VariableFont_wght&quot;); -unity-font-style: bold; color: rgb(255, 255, 255); font-size: 9px; width: auto; align-self: center; -unity-text-align: upper-center; margin-bottom: 4px; padding-bottom: 0; margin-left: 0; margin-right: 0; padding-right: 0; padding-left: 0; padding-top: 0;"/>
                <ui:VisualElement style="flex-grow: 1; aspect-ratio: 1; width: 50px; background-color: rgba(255, 255, 255, 0); height: 50px; min-width: 50px; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; align-items: center; justify-content: space-around; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
                    <ui:VisualElement name="semi-transparent" style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgba(255, 88, 90, 0.5); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.8 0.8;"/>
                    <ui:VisualElement name="opaque" style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgb(255, 88, 90); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.5 0.5; position: absolute; bottom: 0; right: 0; top: 0; left: 0;"/>
                    <ui:VisualElement style="flex-grow: 1; aspect-ratio: 1; width: auto; background-color: rgb(255, 255, 255); height: auto; min-width: auto; border-top-left-radius: 100%; border-top-right-radius: 100%; border-bottom-right-radius: 100%; border-bottom-left-radius: 100%; min-height: auto; align-self: center; scale: 0.1 0.1; position: absolute; left: 0; top: 0; right: 0; bottom: 0;"/>
                </ui:VisualElement>
