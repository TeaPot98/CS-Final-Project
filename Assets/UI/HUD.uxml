<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/HUD.uss?fileID=7433441132597879392&amp;guid=bbdbda947039f124a862f4470db57f7c&amp;type=3#HUD"/>
    <ui:VisualElement name="container" style="flex-grow: 1; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
        <ui:VisualElement name="car-stats-container" style="flex-grow: 1; position: absolute; left: auto; bottom: 0; right: 0; flex-wrap: wrap; padding-top: 8px; padding-right: 8px; padding-bottom: 8px; padding-left: 8px;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; flex-basis: auto; justify-content: flex-end; align-items: center; align-self: flex-end;">
                <ui:Label text="100&#10;" name="Speed" style="font-size: 20px; -unity-text-outline-width: 1px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=d47ba0c5d91fd714aafb7dc6e31a9c3d&amp;type=3#Nunito-VariableFont_wght&quot;); -unity-text-outline-color: rgb(255, 255, 255); flex-grow: 0; margin-top: 0; padding-top: 0; padding-bottom: 0; margin-bottom: 0; margin-right: 6px; padding-right: 0; align-self: center; color: rgb(255, 255, 255); -unity-font-style: bold;"/>
                <ui:VisualElement style="flex-grow: initial; background-color: rgb(255, 255, 255); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; align-items: center; justify-content: space-around; -unity-text-align: middle-center; padding-top: 2px; padding-right: 4px; padding-bottom: 2px; padding-left: 4px; align-self: center; margin-right: 6px;">
                    <ui:Label text="N" name="Gear" style="position: relative; left: auto; bottom: auto; align-self: center; align-items: center; justify-content: space-around; -unity-text-align: upper-center; color: rgb(0, 0, 0); -unity-text-outline-width: 1px; font-size: 18px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-font-style: bold; -unity-text-outline-color: rgb(0, 0, 0);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label text="1000 RPM" name="RPM" style="font-size: 20px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Nunito-VariableFont_wght.ttf?fileID=12800000&amp;guid=d47ba0c5d91fd714aafb7dc6e31a9c3d&amp;type=3#Nunito-VariableFont_wght&quot;); -unity-text-outline-color: rgb(255, 255, 255); padding-top: 0; padding-bottom: 0; color: rgb(255, 255, 255); -unity-text-outline-width: 1px; -unity-font-style: bold;"/>
        </ui:VisualElement>
        <ui:VisualElement name="wheel-debug-container" style="flex-grow: 1; top: 0; right: 0; position: absolute; flex-direction: row; flex-wrap: wrap; display: flex;">
            <ui:VisualElement name="FL" style="flex-grow: 1;">
                <ui:Label text="FL" name="Label" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="RPM" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipAngle" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipRatio" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="FR" style="flex-grow: 1;">
                <ui:Label text="FR" name="Label" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="RPM" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipAngle" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipRatio" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RL" style="flex-grow: 1;">
                <ui:Label text="RL" name="Label" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="RPM" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipAngle" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipRatio" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
            </ui:VisualElement>
            <ui:VisualElement name="RR" style="flex-grow: 1;">
                <ui:Label text="RR" name="Label" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="RPM" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
                <ui:Label text="3000" name="SlipAngle" class="hudText wheel-stats-grid" style="position: relative; left: auto; bottom: auto;"/>
